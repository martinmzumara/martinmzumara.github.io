---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';

const navLinks = [
  { href: '/', label: 'HOME' },
  { href: '/#projects', label: 'PROJECTS' },
  { href: '/#experience', label: 'EXPERIENCE' },
  { href: '/#contact', label: 'CONTACT' },
];
const description = 'View or download the CV of Martin Mzumara — Software Developer & IT Technician based in Malawi.';
---
<BaseLayout
  title='CV - Martin Mzumara'
  description={description}
  path="/cv/"
  ogType="website"
  ogTitle='CV - Martin Mzumara'
  ogImage="/assets/images/og-cover.jpg?v=2"
  ogImageWidth={1200}
  ogImageHeight={630}
  scripts={['/js/icons.js', '/js/script.js', '/js/terminal.js']}
>
    <Navbar ariaLabel='Main navigation' links={navLinks} action={{ href: '/', label: 'BACK TO HOME', icon: 'ti-arrow-left' }} />

    <main id="main-content" class="container">

        <section class="section-padding" aria-labelledby="cv-title">
            <span class="system-label">$ cat ~/cv/martin-mzumara</span>
            <h1 id="cv-title" class="page-title">Curriculum Vitae</h1>
            <p class="lead-text">Martin Mzumara — Software Developer &amp; IT Technician</p>
            <p>View my CV below or download a copy for later.</p>
            <div class="hero-cta">
                <a href="/cv/Martin-Mzumara-CV.pdf" download="Martin-Mzumara-CV.pdf" class="btn-primary">DOWNLOAD CV (PDF)</a>
                <a href="/cv/Martin-Mzumara-CV.pdf" target="_blank" rel="noopener noreferrer" class="btn-secondary">OPEN PDF IN NEW TAB</a>
            </div>
            <p class="cv-mobile-note">On mobile, use the buttons above to open or download the two-page PDF.</p>
            <div class="cv-frame" data-term="~/cv/Martin-Mzumara-CV.pdf">
                <h2 class="sr-only">CV preview</h2>
                <iframe src="/cv/Martin-Mzumara-CV.pdf" title="Martin Mzumara’s CV — PDF preview" loading="lazy"></iframe>
                <p class="cv-note">Preview unavailable? <a href="/cv/Martin-Mzumara-CV.pdf" target="_blank" rel="noopener noreferrer">Open the PDF in a new tab</a> or use the download button above.</p>
            </div>
        </section>
    </main>
</BaseLayout>
