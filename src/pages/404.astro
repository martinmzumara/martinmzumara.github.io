---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ChapterHead from '../components/ChapterHead.astro';

const navLinks = [
  { href: '/#expertise', label: 'EXPERTISE' },
  { href: '/#projects', label: 'PROJECTS' },
  { href: '/#experience', label: 'EXPERIENCE' },
];
---
<BaseLayout
  title="404 - Page Not Found | Martin Mzumara"
  description="The page you're looking for could not be found. Return to Martin Mzumara's portfolio homepage."
  path="/404.html"
  ogType="website"
  ogTitle="404 - Page Not Found | Martin Mzumara"
  ogDescription="The page you're looking for could not be found. Return to Martin Mzumara's portfolio homepage."
  canonical={false}
  robots="noindex, nofollow"
  scripts={['/js/icons.js', '/js/script.js']}
>
    <Navbar links={navLinks} action={{ href: '/cv/', label: 'VIEW RESUME' }} />

    <main id="main-content">
        <!-- Single chapter band: flat, hairline structure, no glass panel -->
        <section class="chapter-section surface-a">
            <div class="container">
                <ChapterHead
                    num="404"
                    label="System error: resource not found"
                    title="Page not found."
                    lead="The page you're looking for doesn't exist, may have been moved, or the link is broken. Let's get you back on track."
                    as="h1"
                    display
                />

                <div class="hero-cta">
                    <a href="/" class="btn-primary">
                        <i class="ti ti-home" aria-hidden="true"></i> BACK TO HOME
                    </a>
                    <a href="/#projects" class="btn-secondary">
                        <i class="ti ti-folder" aria-hidden="true"></i> VIEW PROJECTS
                    </a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
