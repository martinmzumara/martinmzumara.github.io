---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';

const navLinks = [
  { href: '#overview', label: 'OVERVIEW' },
  { href: '#functionality', label: 'FUNCTIONALITY' },
  { href: '#stack', label: 'STACK' },
  { href: '#insights', label: 'INSIGHTS' },
];
const description = 'EncPlus: AES-256 file encryption app with Firebase auth. Encrypt, store & manage files securely.';
---
<BaseLayout
  title='EncPlus - AES File Encryption | Martin Mzumara'
  description={description}
  path="/encplus/"
  ogType="article"
  ogTitle='EncPlus – AES File Encryption'
  ogImage="/assets/images/og-cover.jpg?v=2"
  ogImageWidth={1200}
  ogImageHeight={630}
  scripts={['/js/icons.js', '/js/script.js', '/js/terminal.js']}
>
    <Navbar ariaLabel='Case study navigation' links={navLinks} action={{ href: '/#projects', label: 'BACK TO PROJECTS', icon: 'ti-arrow-left' }} />

    <main id="main-content" class="container project-detail-container">

        <!-- Hero Title Section -->
        <div class="project-detail-header">
            <span class="system-label">$ cat ~/projects/encplus</span>
            <h1 class="main-title">EncPlus – AES File Encryption</h1>
            <p class="lead-text">A cross-platform mobile application for encrypting and decrypting files using AES-256 encryption, with Firebase authentication and secure file management. Currently in development.</p>
            <div class="hero-cta project-actions">
                <a href="https://github.com/martinmzumara/encplus" target="_blank" rel="noopener noreferrer" class="btn-primary">
                    <i class="ti ti-brand-github"></i> VIEW REPOSITORY
                </a>
            </div>
        </div>

        <!-- System Specifications -->
        <div class="specs-grid">
            <div class="spec-card" data-term="~/spec/role">
                <span class="spec-label">ROLE</span>
                <span class="spec-value">Lead Developer</span>
            </div>
            <div class="spec-card" data-term="~/spec/mobile-frontend">
                <span class="spec-label">MOBILE FRONTEND</span>
                <span class="spec-value">Flutter, Dart</span>
            </div>
            <div class="spec-card" data-term="~/spec/backend-and-data">
                <span class="spec-label">BACKEND & DATA</span>
                <span class="spec-value">Firebase Auth, Realtime Database</span>
            </div>
            <div class="spec-card" data-term="~/spec/encryption">
                <span class="spec-label">ENCRYPTION</span>
                <span class="spec-value">AES-256</span>
            </div>
            <div class="spec-card" data-term="~/spec/platform-targets">
                <span class="spec-label">PLATFORM TARGETS</span>
                <span class="spec-value">iOS, Android</span>
            </div>
        </div>

        <!-- Project Stats -->
        <section class="section-padding" id="overview">
            <span class="system-label">$ cat metrics.log</span>
            <h2 class="section-title underline">At A Glance</h2>
            
            <div class="stats-grid">
                <div class="stat-card" data-term="~/metrics/core-screens">
                    <span class="stat-value">3</span>
                    <span class="stat-label">Core Screens</span>
                </div>
                <div class="stat-card" data-term="~/metrics/encryption-algorithm">
                    <span class="stat-value">1</span>
                    <span class="stat-label">Encryption Algorithm</span>
                </div>
                <div class="stat-card" data-term="~/metrics/auth-methods">
                    <span class="stat-value">2</span>
                    <span class="stat-label">Auth Methods</span>
                </div>
                <div class="stat-card" data-term="~/metrics/compatibility">
                    <span class="stat-value">Cross-platform</span>
                    <span class="stat-label">Compatibility</span>
                </div>
            </div>
        </section>

        <!-- Architecture Overview -->
        <section class="section-padding">
            <span class="system-label">$ tree ~/projects/encplus</span>
            <h2 class="section-title underline">System Design</h2>
            
            <div class="architecture-flow">
                <div class="arch-node">
                    <i class="ti ti-device-mobile icon-large"></i>
                    <h3>Flutter Application</h3>
                    <p>Cross-platform mobile app built with Flutter and Dart, featuring secure file encryption/decryption operations.</p>
                </div>
                <div class="arch-arrow">
                    <i class="ti ti-arrow-right"></i>
                </div>
                <div class="arch-node">
                    <i class="ti ti-database icon-large"></i>
                    <h3>Firebase Realtime DB</h3>
                    <p>Secure metadata storage and user authentication state synchronization.</p>
                </div>
                <div class="arch-arrow">
                    <i class="ti ti-arrow-right"></i>
                </div>
                <div class="arch-node">
                    <i class="ti ti-lock icon-large"></i>
                    <h3>AES-256 Encryption</h3>
                    <p>Industry-standard symmetric encryption for securing file contents on the device.</p>
                </div>
            </div>
        </section>

        <!-- Key Features -->
        <section class="section-padding" id="functionality">
            <span class="system-label">$ cat features.md</span>
            <h2 class="section-title underline">Key Features</h2>
            
            <div class="features-grid">
                <div class="feature-card">
                    <i class="ti ti-lock icon-large"></i>
                    <h3>AES-256 Encryption</h3>
                    <p>Secure file encryption using the Advanced Encryption Standard with 256-bit keys, providing military-grade security for sensitive data.</p>
                </div>
                <div class="feature-card">
                    <i class="ti ti-user-check icon-large"></i>
                    <h3>Firebase Authentication</h3>
                    <p>Secure user authentication ensuring only authorized individuals can access encrypted files and app features.</p>
                </div>
                <div class="feature-card">
                    <i class="ti ti-folder icon-large"></i>
                    <h3>File Management</h3>
                    <p>Intuitive interface for file selection, encryption, decryption, and secure storage operations.</p>
                </div>
            </div>
        </section>

        <!-- Technical Overview -->
        <section class="section-padding" id="stack">
            <span class="system-label">$ ls ~/stack/</span>
            <h2 class="section-title underline">Tools & Technologies</h2>
            
            <div class="stack-categories">
                <div class="stack-category">
                    <h3 class="stack-title"><i class="ti ti-code icon-blue"></i> Frontend</h3>
                    <div class="stack-tags">
                        <span class="tag">Flutter</span>
                        <span class="tag">Dart</span>
                    </div>
                </div>
                <div class="stack-category">
                    <h3 class="stack-title"><i class="ti ti-database icon-blue"></i> Backend & Data</h3>
                    <div class="stack-tags">
                        <span class="tag">Firebase Auth</span>
                        <span class="tag">Firebase Realtime DB</span>
                    </div>
                </div>
                <div class="stack-category">
                    <h3 class="stack-title"><i class="ti ti-lock icon-blue"></i> Security</h3>
                    <div class="stack-tags">
                        <span class="tag">AES-256</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Challenges & Solutions -->
        <section class="section-padding" id="insights">
            <span class="system-label">$ tail -f lessons.log</span>
            <h2 class="section-title underline">Challenges & Solutions</h2>
            
            <div class="challenge-grid">
                <div class="challenge-card">
                    <span class="challenge-tag">ENCRYPTION PERFORMANCE</span>
                    <h3>Balanced Security & Speed</h3>
                    <p><strong>Challenge:</strong> Implementing AES-256 encryption that provides strong security without significant performance impact on mobile devices.</p>
                    <p><strong>Solution:</strong> Optimized encryption operations with efficient key management and background processing for non-blocking user experience.</p>
                </div>
                <div class="challenge-card">
                    <span class="challenge-tag">USER EXPERIENCE</span>
                    <h3>Intuitive File Operations</h3>
                    <p><strong>Challenge:</strong> Designing an intuitive interface for file selection, encryption, and decryption that is accessible to all users.</p>
                    <p><strong>Solution:</strong> Clean UI with clear workflow, file preview thumbnails, and contextual help tips throughout the encryption process.</p>
                </div>
            </div>
        </section>

        <!-- Image Gallery Showcase -->
        <section class="section-padding">
            <span class="system-label">$ ls ~/screens/</span>
            <h2 class="section-title underline">Application Screenshots</h2>

            <div class="gallery-grid">
                <div class="gallery-card" data-term="~/screens/encryption-interface">
                    <div class="gallery-placeholder">
                        <i class="ti ti-lock placeholder-icon"></i>
                    </div>
                    <div class="gallery-info">
                        <h3>Encryption Interface</h3>
                        <p>Secure file encryption screen with progress indicators.</p>
                    </div>
                </div>

                <div class="gallery-card" data-term="~/screens/file-selection">
                    <div class="gallery-placeholder">
                        <i class="ti ti-folder placeholder-icon"></i>
                    </div>
                    <div class="gallery-info">
                        <h3>File Selection</h3>
                        <p>Intuitive file browser for selecting files to encrypt or decrypt.</p>
                    </div>
                </div>

                <div class="gallery-card" data-term="~/screens/decryption-results">
                    <div class="gallery-placeholder">
                        <i class="ti ti-lock-open placeholder-icon"></i>
                    </div>
                    <div class="gallery-info">
                        <h3>Decryption Results</h3>
                        <p>Decryption confirmation and file integrity verification.</p>
                    </div>
                </div>
            </div>

            <!-- GitHub CTA -->
            <div class="project-cta-box">
                <h3>Explore the full implementation</h3>
                <p>View the complete Flutter source code on GitHub, including all screens, services, and encryption logic.</p>
                <a href="https://github.com/martinmzumara/encplus" target="_blank" rel="noopener noreferrer" class="btn-primary">
                    <i class="ti ti-brand-github"></i> VIEW REPOSITORY ON GITHUB
                </a>
            </div>
        </section>
    </main>
</BaseLayout>
